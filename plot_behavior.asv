close all
clear all
folder = "/Users/kloosterman/Library/CloudStorage/OneDrive-Personal/Documents/Entropy_in_aging/stats_structs";
cd(folder)
plotfolder = "/Users/kloosterman/Library/CloudStorage/OneDrive-Personal/Documents/Entropy_in_aging/plots";

load stat_mse_2group_blink.mat

load colormap_jetlightgray.mat

set(groot,'defaultFigureColor','w')
set(groot,'defaultAxesColor','w')
set(groot,'defaultAxesXColor','k')
set(groot,'defaultAxesYColor','k')
set(groot,'defaultTextColor','k')
set(groot,'defaultLegendColor','w')
set(groot,'defaultLegendTextColor','k')
set(groot,'defaultLegendEdgeColor','k')

%% Z-score behavioral data

behav = stat_mse_2group.results.stacked_behavdata;
behav_z = zscore(behav);

behav_YA = behav_z(1:20,:);
behav_OA = behav_z(21:end,:);

nBehav = size(behav_z,2);

%% Means
m_YA = mean(behav_YA,1);
m_OA = mean(behav_OA,1);

%% SEM
sem_YA = std(behav_YA,[],1)./sqrt(size(behav_YA,1));
sem_OA = std(behav_OA,[],1)./sqrt(size(behav_OA,1));

%% Labels (test names)

pretty_labels = {
'd2'
'VLMT total'
'VLMT T1'
'VLMT T5'
'VLMT Interf.'
'VLMT Delay'
'WMT-2'
'Digit span total'
'Digit span fwd'
'Digit span bwd'
'MWT-B'
};

%% Reorder according to PLS structure

ord = [2 3 6 4 5 1 10 8 9 7 11];

m_YA  = m_YA(ord);
m_OA  = m_OA(ord);

sem_YA = sem_YA(ord);
sem_OA = sem_OA(ord);

pretty_labels = pretty_labels(ord);

%% Colors (same scheme)

col_YA_bar = [0.9 0.45 0.45];
col_OA_bar = [0.45 0.65 0.9];

col_YA_err = [0.75 0.15 0.15];
col_OA_err = [0.15 0.35 0.75];

%% Data matrix
M = [m_YA; m_OA]';

%% Plot

figure
set(gcf,'Units','centimeters')
set(gcf,'Position',[5 5 13 6])
set(gcf,'Color','w')

tiledlayout(1,4)
nexttile()
hold on

b = bar(M,'grouped','BarWidth',0.75);

b(1).FaceColor = col_YA_bar;
b(1).EdgeColor = 'none';

b(2).FaceColor = col_OA_bar;
b(2).EdgeColor = 'none';

xYA = b(1).XEndPoints;
xOA = b(2).XEndPoints;

%% Errorbars

errorbar(xYA,m_YA,sem_YA,...
    'Color',col_YA_err,...
    'LineStyle','none',...
    'LineWidth',1,...
    'CapSize',6)

errorbar(xOA,m_OA,sem_OA,...
    'Color',col_OA_err,...
    'LineStyle','none',...
    'LineWidth',1,...
    'CapSize',6)

%% Axes

yline(0,'k')

xlim([0.5 nBehav+.5])

xticks(1:nBehav)
xticklabels(pretty_labels)
xtickangle(35)

ylabel('Behavior (z-score)')

box off
set(gca,'FontSize',9)
set(gca,'Color','w')

%% Domain separators

yl = ylim;

sep = [5.5 6.5 9.5 10.5];

for s = sep
    plot([s s],yl,...
        'Color',[0.85 0.85 0.85],...
        'LineWidth',1)
end

%% Domain labels

y_domain = yl(2) + 0.1;

text(3,   y_domain,'Verbal memory','HorizontalAlignment','center','FontSize',9)
text(6,   y_domain,'Attention','HorizontalAlignment','center','FontSize',9)
text(8,   y_domain,'Working memory','HorizontalAlignment','center','FontSize',9)
text(10,  y_domain,'Fl. IQ','HorizontalAlignment','center','FontSize',9)
text(11,  y_domain,'Cr. IQ','HorizontalAlignment','center','FontSize',9)

ylim([yl(1) yl(2)+0.2])

%% Legend

lg = legend({'Young','Older'},'Location','best');
lg.Position =  [  0.3588    0.7540    0.1662    0.1254];

% lg.LineWidth = 1;
lg.Color = 'w';
lg.TextColor = 'k';
lg.Box ="off";

%% --- Correlation matrix (ALL subjects only) ---
behav = stat_mse_2group.results.stacked_behavdata;
behav_z = zscore(behav);

test_labels = { ...
    'WMT-2','Digit Span','d2','TMT-A','TMT-B', ...
    'VLMT','Corsi','Stroop','Go/No-Go','N-Back','MWT-B'};

nTests = size(behav_z,2);

%% Correlations
[R_all, P_all] = corr(behav_z, 'rows','pairwise');

%% Keep strict lower triangle only
mask_keep = tril(true(nTests), -1);
R_all(~mask_keep) = NaN;
P_all(~mask_keep) = NaN;

%% --- Plot in tile 4 ---
nexttile(4)

imagesc(R_all, [-1 1])
axis square
set(gca, ...
    'XTick',1:nTests, ...
    'YTick',1:nTests, ...
    'XTickLabel',test_labels, ...
    'YTickLabel',test_labels, ...
    'XTickLabelRotation',45, ...
    'FontSize',9, ...
    'TickLength',[0 0], ...
    'YDir','normal')

title('Behavior correlations (all subjects)')
colormap(parula)

ax = gca;
ax.Color = [1 1 1]; % NaNs white

hold on

% subtle grid
for i = 0.5:1:nTests+0.5
    plot([0.5 nTests+0.5],[i i],'-','Color',[0.85 0.85 0.85],'LineWidth',0.5)
    plot([i i],[0.5 nTests+0.5],'-','Color',[0.85 0.85 0.85],'LineWidth',0.5)
end

% significance stars
for i = 1:nTests
    for j = 1:nTests
        if i > j && ~isnan(P_all(i,j))
            if P_all(i,j) < .001
                stars = '***';
            elseif P_all(i,j) < .01
                stars = '**';
            elseif P_all(i,j) < .05
                stars = '*';
            else
                stars = '';
            end

            if ~isempty(stars)
                text(j,i,stars, ...
                    'HorizontalAlignment','center', ...
                    'VerticalAlignment','middle', ...
                    'FontSize',10, ...
                    'FontWeight','bold', ...
                    'Color','k');
            end
        end
    end
end

xlim([0.5 nTests+0.5])
ylim([0.5 nTests+0.5])
colorbar

%% Export (optional)

% exportgraphics(gcf,'behavior_group_differences.pdf',...
%     'ContentType','vector',...
%     'BackgroundColor','white')set(gcf,'Color','w')
exportgraphics(gcf,fullfile(plotfolder, 'behavior.pdf'),'ContentType','vector')






